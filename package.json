{
  "name": "nest-pokemon",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint --ignore-pattern \"src/generated/**\" src test && eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "check": "npm run lint && npm run build && npm run test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "typespec:compile": "tsp compile tsp/main.tsp --config tspconfig.yaml",
    "typespec:watch": "tsp compile tsp/main.tsp --config tspconfig.yaml --watch",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.0-alpha.5",
    "@nestjs/core": "^12.0.0-alpha.5",
    "@nestjs/platform-express": "^12.0.0-alpha.5",
    "@praha/byethrow": "^0.10.1",
    "@praha/error-factory": "^1.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ts-pattern": "^5.9.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@hey-api/openapi-ts": "^0.95.0",
    "@nestjs/cli": "^12.0.0-alpha.6",
    "@nestjs/schematics": "^12.0.0-alpha.9",
    "@nestjs/testing": "^12.0.0-alpha.5",
    "@rspack/core": "^2.1.4",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@typespec/compiler": "^1.10.0",
    "@typespec/http": "^1.10.0",
    "@typespec/openapi": "^1.10.0",
    "@typespec/openapi3": "^1.10.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "oxlint": "^1.74.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^4.1.10",
    "webpack-node-externals": "^3.0.0"
  }
}
